# The build context is the repository minus everything the image does not read.
# Every dot-file and dot-directory at the top level (version control, the virtual
# environment, caches, editor and tool folders): the build reads none of them.
.*
**/node_modules
**/__pycache__
**/*.pyc
ui/dist
wheels

# Secrets never go into an image.
.env
.env.*

# data/: only the label database, the cited directory and the coverage rows. The caches (1.7 GB), the case
# store, the desk, officer accounts, the token secret and the audit log stay on the host.
data/*
!data/labels.duckdb
!data/vasp_directory.yaml
!data/ps_coverage.yaml

# tests/: only the recorded demo fixtures and their golden fingerprints.
tests/*
!tests/fixtures
tests/fixtures/*
!tests/fixtures/demo
!tests/golden

derived
research
