wheels/

# Built from ../research/data by `make labels`; ~115k rows, rebuilt in seconds.
data/labels.duckdb
data/*.duckdb.tmp
data/case.duckdb
# Chain API responses (B2). Rebuilt by fetching live; OFFLINE=1 replays from it.
data/chain_cache.duckdb
# The discovery crawl's own cache (B4). `make discover` refills it; derived/ is tracked.
data/discover_cache.duckdb
data/uploads/
data/exports/
ui/dist/

# Local secrets (API keys). Never commit.
.env
.env.*
# The deposit model's own fetches (B6). `make model-data` refills it; artifacts/model_v1 is tracked.
data/model_cache.duckdb
artifacts/**/model.pkl
# The abstain validation's own traces (B7). `make abstain-eval` refills it; artifacts/abstain_v1 is tracked.
data/abstain_cache.duckdb
