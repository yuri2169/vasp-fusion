.venv/
node_modules/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
wheels/

# Built from ../research/data by `make labels` (the label sets are not in this repository),
# or by `make demo-labels` from tracked files (only the labels the recorded demo read).
data/labels.duckdb
data/*.duckdb.tmp
data/case.duckdb
# Chain API responses (B2). Rebuilt by fetching live; OFFLINE=1 replays from it.
data/chain_cache.duckdb
# The discovery crawl's own cache (B4). `make discover` refills it; derived/ is tracked.
data/discover_cache.duckdb
data/uploads/
data/exports/
ui/dist/

# Local secrets (API keys). Never commit.
.env
.env.*
# The deposit model's own fetches (B6). `make model-data` refills it; artifacts/model_v1 is tracked.
data/model_cache.duckdb
artifacts/**/model.pkl
# The abstain validation's own traces (B7). `make abstain-eval` refills it; artifacts/abstain_v1 is tracked.
data/abstain_cache.duckdb
# The request desk (B8): requests drafted on this machine, and the mock SAHYOG outbox.
data/desk.duckdb
data/watch.duckdb
data/sahyog_outbox/
# The SAHYOG intake's API key, written by the demo set-up (`make demo`). Never commit.
data/sahyog_api_key
# Login and audit (B9): officer accounts (password hashes), the token secret, the audit log.
data/officers.json
data/officers.json.tmp
data/auth_secret
data/audit.duckdb
data/audit.duckdb.key
# The demo's chain cache, built from tests/fixtures/demo by `make demo-cache`.
data/demo_cache.duckdb
# `make reproduce` writes its demo cache and cases here, not to the working stores.
data/reproduce/
data/risk_validation_cache.duckdb
data/risk_validation_cache.rows.jsonl
data/documented_cache.duckdb
